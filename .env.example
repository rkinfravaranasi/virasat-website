# Database Connection URL (SQLite default for zero-dependency local dev; switch to PostgreSQL/MySQL for production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/virasat_db?schema=public"

# Node Environment
NODE_ENV="development"

# Admin Secret / Cookie Salt (generate a secure random 32-character string in production)
ADMIN_JWT_SECRET="virasat_luxury_real_estate_secret_salt_2026"

# Next.js Base URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
